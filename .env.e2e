# Environnement des tests navigateur (Playwright) : base SQLite jetable, aucun secret.
# Chargé automatiquement quand APP_ENV=e2e. Ne jamais utiliser en production.
APP_NAME="État des lieux (e2e)"
APP_ENV=e2e
APP_KEY=base64:ZTJlLXRlc3Qta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8799
APP_LOCALE=fr

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stderr

MICROSOFT_CLIENT_ID=e2e
MICROSOFT_CLIENT_SECRET=e2e
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8799/auth/microsoft/callback
MICROSOFT_TENANT_ID=e2e
